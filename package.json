{
  "name": "hostvra-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Hostvra - Production-grade self-hosted server and hosting management platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "test": "npm --prefix apps/web run test"
  },
  "keywords": [
    "hosting",
    "control-panel",
    "server-management",
    "vps",
    "nginx",
    "docker",
    "hostvra"
  ],
  "author": "Hostvra Core Team",
  "license": "Apache-2.0"
}
