[Unit]
Description=Hostvra Core Control Plane API
Documentation=https://docs.hostvra.com/api
After=network.target network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/hostvra
EnvironmentFile=-/etc/hostvra/api.env
ExecStart=/usr/local/bin/hostvra-api
Restart=always
RestartSec=3s
LimitNOFILE=65536
KillMode=process
TimeoutStopSec=15

# Security Sandboxing
ProtectSystem=false
PrivateTmp=true
ReadWritePaths=/var/lib/hostvra /var/log/hostvra

[Install]
WantedBy=multi-user.target
