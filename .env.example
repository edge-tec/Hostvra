# Hostvra Platform Configuration Example

# Server Environment
ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# Database (PostgreSQL)
DATABASE_URL=postgres://hostvra:hostvra_dev_password@localhost:5432/hostvra?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=replace_with_a_super_secret_64_char_random_string_for_production
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.hostvra.com

# Licensing Service
HOSTVRA_LICENSE_ENDPOINT=https://license.hostvra.com/v1/verify
HOSTVRA_SYSTEM_EDITION=community # community, pro, enterprise

# Structured Logging
LOG_LEVEL=debug # debug, info, warn, error
LOG_FORMAT=json # json, text

# Domain Reseller System (ResellerClub HTTP API)
DOMAIN_REGISTRAR=resellerclub
RESELLERCLUB_MODE=sandbox # sandbox, production
RESELLERCLUB_RESELLER_ID=your_reseller_id_here
RESELLERCLUB_API_KEY=your_resellerclub_api_key_here
RESELLERCLUB_API_BASE_URL=https://test.httpapi.com/api/
RESELLERCLUB_API_TIMEOUT_SECONDS=30
DOMAIN_DEFAULT_NS1=ns1.hostvra.com
DOMAIN_DEFAULT_NS2=ns2.hostvra.com
DOMAIN_ENCRYPTION_SECRET=replace_with_a_32_character_encryption_secret_key

